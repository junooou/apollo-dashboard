# Copy this file to .env.local and fill in the key.
# Get one at: Apollo.io -> Settings -> Integrations -> API -> API Keys
# The key needs "master" scope to use search + enrichment endpoints.
APOLLO_API_KEY=


# Optional. Where generated CSVs get saved when you use "Save to folder".
# Defaults to the sibling "Apollo Lead Generation" directory.
# OUTPUT_DIR=/Users/you/Desktop/voncierge/Apollo Lead Generation


# --- OpenAI (email template generator) -------------------------------------
# Powers app/api/generate-template/route.ts — generates per-company /
# per-industry outreach email campaigns. Required for that feature.
# Get one at: platform.openai.com -> API keys -> Create new secret key
OPENAI_API_KEY=


# --- Google Sheets ---------------------------------------------------------
# Service account, not OAuth: no consent screen, no refresh token to manage.
# Setup: console.cloud.google.com -> enable "Google Sheets API" (and "Google
# Drive API" if you want the app to create + auto-share new spreadsheets) ->
# APIs & Services -> Credentials -> Create Credentials -> Service Account ->
# open it -> Keys -> Add Key -> Create new key -> JSON.
#
# The service account has ZERO access to any sheet until you share that sheet
# with GOOGLE_SERVICE_ACCOUNT_EMAIL below (Editor), same as sharing with any
# other Google account.

# From the downloaded JSON: the "client_email" field.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# From the downloaded JSON: the "private_key" field, pasted as one line with
# literal \n sequences kept intact (that's how it comes out of the JSON) —
# do not replace them with real newlines. Keep the quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional. The spreadsheet ID from its URL:
# docs.google.com/spreadsheets/d/THIS_PART/edit
# Only needed by scripts/check-sheets.ts to verify access to a real sheet.
# GOOGLE_SHEET_ID=

# Required if the dashboard should CREATE new spreadsheets.
#
# Service accounts do not have their own Google Drive storage quota.
# Use a folder located inside a Google Shared Drive and give the service
# account permission to create/edit files there.
#
# Paste the folder ID from:
# drive.google.com/drive/folders/THIS_PART
#
# New spreadsheets created by the dashboard will be placed inside this folder.
#
# Not required if you only read/update already-existing spreadsheets.
# GOOGLE_PARENT_FOLDER_ID=

# Optional: used only by `npm run check-sheets`.
# Set this to your own email address if you want the Google Sheets test
# to share newly created test sheets back to you.
# GOOGLE_CHECK_SHARE_WITH=you@example.com

# Optional. Pins the "Job Signals Outreach" sheet (Explore Outreach, see
# app/api/job-signal-outreach/route.ts) to a specific spreadsheet ID instead
# of finding-or-creating one named "Job Signals Outreach" inside
# GOOGLE_PARENT_FOLDER_ID. Only needed if that sheet was created by hand and
# lives somewhere the folder scan wouldn't find it.
# GOOGLE_JOB_SIGNALS_SHEET_ID=

# OpenAI API key.
# Used for:
# - scoring news trigger articles
# - generating outreach email sequences
# - finding a property's managing company (Lead Sourcing tab, web-search-grounded)
# Create your own key in the OpenAI developer dashboard.
OPENAI_API_KEY=

# Currents API key.
# Used by the News Triggers feature to fetch fresh news articles.
# Each person running the app locally should use their own Currents API key.
CURRENTS_API_KEY=

# Base URL of the app.
# For local development, use:
# NEXT_PUBLIC_APP_URL=http://localhost:3100
#
# If the app is deployed later, replace this with the deployed URL.
NEXT_PUBLIC_APP_URL=

# Secret used to protect the automated news-refresh cron endpoint.
# Generate a random value locally with:
# openssl rand -hex 32
#
# Do NOT share or commit the real secret.
CRON_SECRET=

# Resend API key.
# Used to send automatic email alerts when NEW news articles
# score 70 or above.
# Create your own API key in Resend.
RESEND_API_KEY=

# Email address that should RECEIVE News Trigger alerts.
# Example:
# NEWS_ALERT_EMAIL=yourname@company.com
NEWS_ALERT_EMAIL=

# Sender name/address used for News Trigger emails.
# During testing with Resend's default sender, use:
# NEWS_ALERT_FROM=Voncierge Intelligence <onboarding@resend.dev>
#
# If a company domain is verified in Resend later,
# replace this with the official sender address.
NEWS_ALERT_FROM=

# GMass API key.
# Used to create/send outreach campaigns through the connected GMass account.
# The key should be generated from the GMass account that is meant to send
# the campaigns (for example, Amanda's GMass account).
GMASS_API_KEY=

# Email address campaigns should be sent from through GMass.
# Must be an authenticated From Address in the GMass/Gmail account
# associated with the API key.
GMASS_FROM_EMAIL=