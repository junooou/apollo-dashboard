# Copy this file to .env.local and fill in the key.
# Get one at: Apollo.io -> Settings -> Integrations -> API -> API Keys
# The key needs "master" scope to use search + enrichment endpoints.
APOLLO_API_KEY=


# Optional. Where generated CSVs get saved when you use "Save to folder".
# Defaults to the sibling "Apollo Lead Generation" directory.
# OUTPUT_DIR=/Users/you/Desktop/voncierge/Apollo Lead Generation


# --- Google Sheets ---------------------------------------------------------
# Service account, not OAuth: no consent screen, no refresh token to manage.
# Setup: console.cloud.google.com -> enable "Google Sheets API" (and "Google
# Drive API" if you want the app to create + auto-share new spreadsheets) ->
# APIs & Services -> Credentials -> Create Credentials -> Service Account ->
# open it -> Keys -> Add Key -> Create new key -> JSON.
#
# The service account has ZERO access to any sheet until you share that sheet
# with GOOGLE_SERVICE_ACCOUNT_EMAIL below (Editor), same as sharing with any
# other Google account.

# From the downloaded JSON: the "client_email" field.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# From the downloaded JSON: the "private_key" field, pasted as one line with
# literal \n sequences kept intact (that's how it comes out of the JSON) —
# do not replace them with real newlines. Keep the quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional. The spreadsheet ID from its URL:
# docs.google.com/spreadsheets/d/THIS_PART/edit
# Only needed by scripts/check-sheets.ts to verify access to a real sheet.
# GOOGLE_SHEET_ID=

# Optional but needed to CREATE new spreadsheets. A bare service account has
# no Drive storage quota of its own, so spreadsheets.create() 403s without
# this: create a folder in YOUR OWN Drive, share it with
# GOOGLE_SERVICE_ACCOUNT_EMAIL above (Editor), and paste the folder ID here
# (from its URL: drive.google.com/drive/folders/THIS_PART). New sheets get
# created inside it and count against your quota, not the service account's.
# Not needed if you only read/update sheets that already exist.
# GOOGLE_PARENT_FOLDER_ID=

# Optional, used only by `npm run check-sheets`: your own email, to verify
# a newly created sheet gets shared back to you too.
# GOOGLE_CHECK_SHARE_WITH=you@example.com
